 /* The window surface: the pixels a GDI game's window DCs (GetDC, BeginPaint)
  * draw into, set by the host at the display mode's size. There is one, for
@@ -647,8 +652,25 @@ static void g_GetTextMetricsA(void) {                    /* TEXTMETRICA */
     RET(1, 2);
 }
 
+/* 8bpp: the palette index nearest to an RGB, as GDI maps a COLORREF on a palettised
+ * surface. PALETTEINDEX(i) (0x01000000 | i) is the index itself. */
+static uint32_t nearest_index(const dc_t *d, uint32_t r, uint32_t g, uint32_t b) {
+    uint32_t best = 0, bestd = ~0u;
+    for (uint32_t i = 0; i < 256; i++) {
+        uint32_t pr, pg, pb;
+        if (d->pe) pr = d->pe[i] & 0xFF, pg = (d->pe[i] >> 8) & 0xFF, pb = (d->pe[i] >> 16) & 0xFF;
+        else if (d->ctab) pr = (d->ctab[i] >> 16) & 0xFF, pg = (d->ctab[i] >> 8) & 0xFF, pb = d->ctab[i] & 0xFF;
+        else pr = pg = pb = i;                           /* no palette known: a grey ramp */
+        int dr = (int)pr - (int)r, dg = (int)pg - (int)g, db = (int)pb - (int)b;
+        uint32_t dist = (uint32_t)(dr * dr + dg * dg + db * db);
+        if (dist < bestd) bestd = dist, best = i;
+        if (!dist) break;
+    }
+    return best;
+}
 static uint32_t pack(const dc_t *d, uint32_t cr) {       /* COLORREF 0x00BBGGRR -> the surface's pixel */
     uint32_t r = cr & 0xFF, g = (cr >> 8) & 0xFF, b = (cr >> 16) & 0xFF;
+    if (d->bpp == 8) return (cr >> 24) == 1 ? cr & 0xFF : nearest_index(d, r, g, b);
     if (d->bpp == 16) return d->is555 ? (r >> 3) << 10 | (g >> 3) << 5 | (b >> 3) : (r >> 3) << 11 | (g >> 2) << 5 | (b >> 3);
     return r << 16 | g << 8 | b;
 }
