+/* Hiding or destroying the focus window (or a window holding it) moves the focus to
+ * its parent, with WM_KILLFOCUS / WM_SETFOCUS, as Windows does: a game whose chat box
+ * closes gets its keyboard back in the main window (AoE2's key dispatch checks
+ * GetFocus() is its window or a child of it). A top-level window leaves no focus. */
+static void focus_leaves(win_t *x) {
+    if (!g_focus || !(g_focus == x->hwnd || is_descendant(g_focus, x->hwnd))) return;
+    set_focus(x->parent && W(x->parent) ? x->parent : 0);
+}
