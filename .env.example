# Copy to .env and adjust paths before running `docker compose up -d --build`

# Host address & port exposed by the internal Nginx gateway container.
# Keep 127.0.0.1 when terminating TLS with a host Nginx reverse proxy.
AOE2_BIND=127.0.0.1
AOE2_PORT=8642

# Paths on the Docker host mounted read-only into the containers
AOE2_WEB_DIR=./web
AOE2_BUILD_DIR=./build/web
AOE2_INSTALL_DIR=../aoe2-recomp-work/install

# Set AOE2_NO_INSTALL=1 to disable serving preloaded game assets
AOE2_NO_INSTALL=0

# Optional build version tag (combined automatically with aoe2.wasm mtime)
AOE2_VERSION=

# Image used by the relay and web services. Multi-arch (amd64, arm64, arm/v7), so
# a Raspberry Pi or Apple Silicon Mac can `docker compose pull` instead of building.
AOE2_IMAGE=ghcr.io/aesaganda/aoe2-recomp-web
AOE2_IMAGE_TAG=latest

# Multiplayer relay capacity limits
AOE2_MAX_CONNS=200
AOE2_MAX_CONNS_PER_IP=16
AOE2_MAX_ROOMS=50

# Optional turnkey prebuilt bundle (skips ISO extraction and Ghidra/Emscripten build).
# Supports https://, http://, gh://owner/repo[@tag]/asset, ssh://user@host/path, or a local .tar.gz file.
# Set AOE2_BUNDLE_TOKEN or AOE2_BUNDLE_HEADER in the shell environment (never commit tokens here).
AOE2_BUNDLE_URL=
AOE2_BUNDLE_SHA256=

