# Original game binaries and data: user-supplied, never committed (ADR-0002)
/orig/
*.exe
*.dll
*.iso
*.drs
*.dat
*.mgx
*.mgz

# Anything derived from the binary's code (lifted C, disassembly dumps,
# Ghidra projects, extracted bytes) stays local (ADR-0002)
/build/
/out/
*.gpr
*.rep/

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# local tooling (the desktop app's launch config: machine paths)
/.claude/

# Docker / local env
.env

# play.sh: the install tree laid out from your discs
/install/
/install.tmp/

# Turnkey prebuilt bundles (user-supplied, never committed)
/bundle.tmp/
aoe2-bundle*.tar
aoe2-bundle*.tar.gz
aoe2-bundle*.tgz
aoe2-bundle*.sha256
*.bundle.tar.gz
